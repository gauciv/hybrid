{
  "manifest_version": 3,
  "name": "Kontrata: check a job offer before you sign",
  "short_name": "Kontrata",
  "version": "0.1.0",
  "description": "Right-click a recruiter post or contract to see DMW red flags. Runs fully on your computer; nothing is sent anywhere.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Kontrata" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
